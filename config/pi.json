  },
  "tof": {
    "max_age_seconds": 0.35, "min_mm": 100, "max_mm": 4000,
    "min_support": 2, "bbox_inset": 0.1, "emergency_mm": 700,
    "emergency_zones": [27, 28, 35, 36], "calibrated": false,
    "projection": {
      "mode": "homography", "matrix": null, "validated_range_mm": [500, 3000],
      "rotate_quarters": 0, "flip_x": false, "flip_y": false
    }
  },
  "runtime": {
    "model_load_timeout": 90, "yolo_timeout": 15, "ocr_timeout": 60,
